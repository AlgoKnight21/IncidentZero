# Copy to .env and adjust. No secrets are required for the local demo.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=
INCIDENTZERO_GRAPH_PREFIX=incidentzero_
INCIDENTZERO_QUERY_TIMEOUT_MS=5000
INCIDENTZERO_RESULT_LIMIT=500
INCIDENTZERO_MAX_INGEST_RECORDS=5000
INCIDENTZERO_MAX_HOPS=4
INCIDENTZERO_SOCKET_TIMEOUT_S=10
# INCIDENTZERO_SCENARIO_ROOT=/app/data/scenarios   (must never point at evaluation/)
